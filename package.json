{
  "name": "msaltnet-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site _site",
    "test": "vitest run && python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "verify": "npm run check && npm run build && npm test",
    "test:baseline": "python3 -m unittest discover -s tests -p 'migration_baseline_parity.py' -v"
  },
  "dependencies": {
    "astro": "7.3.5",
    "hast-util-to-text": "^4.0.2",
    "pagefind": "1.5.2",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.5",
    "@playwright/test": "^1.65.1",
    "rehype-raw": "^7.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
