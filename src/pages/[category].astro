---
import PageLayout from '../layouts/PageLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import SeriesList from '../components/SeriesList.astro';
import { categories, type NavItem } from '../lib/site-data';
import { getSiteContent } from '../lib/data';

export function getStaticPaths() {
  return categories().map((category) => ({ params: { category: category.key }, props: { category } }));
}
const { category } = Astro.props as { category: NavItem };
const { posts, series } = await getSiteContent();
const topicPosts = posts.filter((post) => post.data.category === category.key);
// Posts in a series appear once, inside their series; the rest are listed below.
const seriesIds = new Set(series.map((item) => item.id));
const standalone = topicPosts.filter((post) => !post.data.series || !seriesIds.has(post.data.series));
---
<PageLayout title={category.title} description={category.description ?? ''} path={category.url} section={category.key}>
  <p class="archive-count">{topicPosts.length}편의 글</p>
  <SeriesList series={series} posts={topicPosts} />
  {standalone.length < topicPosts.length && <h2 class="series-index-title">글</h2>}
  <ArticleList posts={standalone} />
</PageLayout>
