---
import { images } from '../lib/site-data';
interface Props { src: string; alt: string; class?: string; sizes?: string; priority?: boolean }
const { src, alt, class: className, sizes = '(max-width: 800px) calc(100vw - 48px), 760px', priority = false } = Astro.props;
const asset = images()[src];
if (!asset) throw new Error(`Missing responsive image metadata for ${src}`);
const srcset = `${asset.mobile} ${asset.mobile_width}w${asset.width > asset.mobile_width ? `, ${asset.src} ${asset.width}w` : ''}`;
---
<img src={asset.src} srcset={srcset} sizes={sizes} width={asset.width} height={asset.height} alt={alt}
  class={className} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async">
