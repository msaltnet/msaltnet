---
// Reproduces the jekyll-seo-tag output of the former site.
import { SITE, absolute } from '../lib/site';
import { images } from '../lib/site-data';
import { isoDate } from '../lib/data';
import { jsonLdText } from '../lib/json-ld';

export interface Props {
  title?: string;
  description?: string;
  path: string;
  image?: string;
  kind: 'home' | 'about' | 'page' | 'article';
  datePublished?: string;
  dateModified?: string;
}
const { title, description = SITE.description, path, image, kind, datePublished, dateModified } = Astro.props;
const url = absolute(path);
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.tagline}`;
const headline = title ?? SITE.title;
const asset = image ? images()[image] : undefined;
const imageUrl = image ? absolute(asset?.social ?? image) : undefined;
const author = { '@type': 'Person', name: SITE.title, url: SITE.authorUrl };
const jsonld = kind === 'article'
  ? { '@context': 'https://schema.org', '@type': 'BlogPosting', author, dateModified: isoDate(dateModified ?? datePublished!),
      datePublished: isoDate(datePublished!), description, headline, ...(imageUrl ? { image: imageUrl } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': url }, url }
  : kind === 'page'
    ? { '@context': 'https://schema.org', '@type': 'WebPage', author, description, headline, ...(imageUrl ? { image: imageUrl } : {}), url }
    : { '@context': 'https://schema.org', '@type': 'WebSite', author, description, headline, ...(imageUrl ? { image: imageUrl } : {}),
        name: SITE.title, sameAs: SITE.sameAs, url };
---
<title>{pageTitle}</title>
<meta property="og:title" content={headline} />
<meta name="author" content={SITE.title} />
<meta property="og:locale" content="ko_KR" />
<meta name="description" content={description} />
<meta property="og:description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={SITE.title} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta property="og:type" content={kind === 'article' ? 'article' : 'website'} />
{kind === 'article' && <meta property="article:published_time" content={isoDate(datePublished!)} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
{imageUrl && <meta property="twitter:image" content={imageUrl} />}
<meta property="twitter:title" content={headline} />
<script type="application/ld+json" is:inline set:html={jsonLdText(jsonld)} />
